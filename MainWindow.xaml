<Window x:Class="MusicWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicWidget" Height="48" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Loaded="MainWindow_Loaded">

    <Border Background="#33808080" CornerRadius="10" Padding="6,4,6,4" MouseLeftButtonDown="Border_MouseLeftButtonDown" VerticalAlignment="Center" Height="40" Margin="0">
        
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="PinMenuItem" Header="Konumu Sabitle" IsCheckable="True" Click="TogglePin_Click"/>
                <MenuItem x:Name="LangMenuItem" Header="Language: English" Click="LangMenuItem_Click"/>
                <Separator Background="#22FFFFFF"/>
                <MenuItem x:Name="ExitMenuItem" Header="Çıkış" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <ColumnDefinition Width="*"/>    <ColumnDefinition Width="Auto"/> </Grid.ColumnDefinitions>

            <Border CornerRadius="5" Width="32" Height="32" Grid.Column="0" Margin="0,0,8,0" Background="#11FFFFFF" VerticalAlignment="Center">
                <Border.Clip>
                    <RectangleGeometry RadiusX="5" RadiusY="5" Rect="0,0,32,32"/>
                </Border.Clip>
                <Image x:Name="AlbumArt" Stretch="UniformToFill"/>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical" Grid.Row="0" Margin="0,0,0,1">
                    <TextBlock x:Name="TrackName" Text="Bilinmiyor" Foreground="White" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" LineHeight="12"/>
                    <TextBlock x:Name="ArtistName" Text="Şarkı bekleniyor..." Foreground="#A0A0A0" FontSize="8.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" LineHeight="10"/>
                </StackPanel>

                <Canvas x:Name="VisualizerCanvas" Grid.Row="1" Height="10" Width="150" HorizontalAlignment="Left" VerticalAlignment="Center" ClipToBounds="True"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.8">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0.5,0,0.5,0"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FF00FFFF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <Button Content="⏮" Width="16" Height="16" FontSize="10" Click="PrevBtn_Click"/>
                <Button Content="⏯" Width="20" Height="20" FontSize="13" Click="PlayPauseBtn_Click" Margin="1,0,1,0"/>
                <Button Content="⏭" Width="16" Height="16" FontSize="10" Click="NextBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>