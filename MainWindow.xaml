<Window x:Class="MusicWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicWidget" Height="40" Width="280"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Loaded="MainWindow_Loaded">
    
    <Border Background="#01000000" MouseLeftButtonDown="Border_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="PinMenuItem" Header="Konumu Sabitle" IsCheckable="True" Click="TogglePin_Click"/>
                <Separator/>
                <MenuItem Header="Uygulamadan Çık" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="AlbumArt" Grid.Column="0" Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                <TextBlock x:Name="TrackName" Text="Çalmıyor" Foreground="White" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistName" Text="" Foreground="#aaaaaa" FontSize="8" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⏮" Click="PrevBtn_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" Width="22"/>
                <Button x:Name="PlayPauseBtn" Content="⏸" Click="PlayPauseBtn_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" Width="22"/>
                <Button Content="⏭" Click="NextBtn_Click" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Foreground="White" Width="22"/>
            </StackPanel>
            <Canvas x:Name="VisualizerCanvas" Grid.Column="3" Width="80" Height="20" VerticalAlignment="Center" HorizontalAlignment="Right" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</Window>